# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Variables MUST start with VITE_ to be exposed to the client.

# EmailJS credentials — used by the Contact form to deliver email.
# Find these in your EmailJS dashboard (https://dashboard.emailjs.com):
#   Service ID:  Email Services
#   Template ID: Email Templates
#   Public Key:  Account → General → Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
