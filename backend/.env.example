# Copy to .env and adjust as needed.

# Comma-separated list of allowed origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP config — only needed if you want the contact endpoint
# to actually send emails. If left blank, messages are logged to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=ashutosh.empli5@gmail.com
